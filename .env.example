JWT_EXPIRES_IN=24h
JWT_SECRET=replace_me
MYSQL_DATABASE=replace_me
MYSQL_HOST=replace_me
MYSQL_PASSWORD=replace_me
MYSQL_USER=replace_me
PORT=5000

# Power Automate HTTP trigger for loaner requests
LOANER_REQUEST_FLOW_URL=https://prod-00.region.logic.azure.com/workflows/replace-me/triggers/manual/paths/invoke?api-version=2016-06-01&sp=replace-me&sv=replace-me&sig=replace-me

# Optional shared secret. If set, ChipBoard sends this as x-chipboard-key.
LOANER_REQUEST_FLOW_KEY=

# Power Automate HTTP trigger for writing Get Ready submissions to shared Excel
GET_READY_EXCEL_FLOW_URL=https://prod-00.region.logic.azure.com/workflows/replace-me/triggers/manual/paths/invoke?api-version=2016-06-01&sp=replace-me&sv=replace-me&sig=replace-me

# Optional shared secret. If set, ChipBoard sends this as x-chipboard-key.
GET_READY_EXCEL_FLOW_KEY=

# Email Configuration for Get Ready Emails
EMAIL_SERVICE=gmail
EMAIL_USER=replace_me
EMAIL_PASSWORD=replace_me

# Enable only after verifying this flow sends approved email without Microsoft approval.
LOANER_APPROVAL_FLOW_READY=false

# Enable workflow only after the additive schema has been installed and verified.
LOANER_WORKFLOW_ENABLED=false
# Uses existing EMAIL_* SMTP configuration; requires chipboard.bot@gmail.com.
LOANER_EMAIL_ENABLED=false
